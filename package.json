{
  "name": "personal-site-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-rss-feeds.mjs && node scripts/fetch-notion-gear.js && vinext build",
    "dev": "vinext dev",
    "start": "vinext start",
    "lint": "eslint . --ext .ts,.tsx",
    "optimize-images": "node scripts/optimize-images.cjs",
    "format": "prettier --ignore-path .gitignore .next \"**/*.{ts,tsx,md}\" --write .",
    "fetch-strava": "node scripts/fetch-strava-data.js",
    "fetch-gear": "node scripts/fetch-notion-gear.js",
    "check-miles": "node scripts/check-miles.js",
    "preview": "vinext build && vinext deploy --preview",
    "deploy": "vinext build && vinext deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@nextui-org/react": "^2.2.9",
    "@notionhq/client": "^2.2.14",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-slot": "^1.2.3",
    "@sanity/client": "^7.13.1",
    "@sanity/code-input": "^5.1.2",
    "@sanity/icons": "^3.7.0",
    "@sanity/image-url": "^1.1.1",
    "@sanity/types": "^3.82.0",
    "@sanity/ui": "^2.0.0",
    "@sanity/vision": "^3.82.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/react-syntax-highlighter": "^15.5.13",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.0",
    "classnames": "^2.5.1",
    "clsx": "^2.1.0",
    "dotenv": "^17.2.1",
    "framer-motion": "^11.11.0",
    "fs-extra": "^11.2.0",
    "lucide-react": "^1.16.0",
    "next": "^15.5.18",
    "next-sanity": "^9.8.30",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "notion-types": "^6.16.0",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.2.6",
    "react-icons": "^5.0.1",
    "react-is": "^19.2.6",
    "react-syntax-highlighter": "^15.6.1",
    "sanity": "^3.82.0",
    "styled-components": "^6.1.8",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.38.0",
    "@cloudflare/workers-types": "^4.20260524.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitejs/plugin-rsc": "^0.5.26",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.33",
    "prettier": "^3.2.0",
    "react-server-dom-webpack": "^19.2.6",
    "sharp": "^0.34.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vinext": "^0.0.52",
    "vite": "^8.0.14",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "@sanity/client": "^7.13.1",
    "framer-motion": "^11.11.0"
