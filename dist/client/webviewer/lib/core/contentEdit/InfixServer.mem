ICENI PREFS
OWNER:INFIX
VERSION:100

[DOC MARKUP]
xStart =<?xml version="1.0" encoding="UTF-8"?>
<DOC>
;
Start=;
xEnd =
</DOC>
;
Nesting Level =0;
[-- END --]

# The 1st line defines the style of a span. This expanded form is injected back
# into the XML during preparation of the MT text we get back from MS Azure.
# The 2nd line is a hacky way of forcing a style into the <p> tag. 
# Only the first of these is used, all the others are redundant. Could eliminate
# the need to do this if we inject the style into the openning <p> tag in C code instead.
[CHARSTYLE_DEFS MARKUP]
Start=
:GD:<g id='[FID]-[STYLENUM]'>@<span style='font:[FONTSTYLE] [WEIGHT] [FONTSIZE]pt [FONTNAME]\; colid:[COLOUR_ID]\; [IS_RAW_CHAR]\; text-rise:[TEXTRISE]\; text-scale:[TEXTSCALE]\; underline:[UNDERLINE]\;'>
:GD:<p x='5' id='[FID]'>@<p id='[FID]' style='font:[FONTSTYLE] [WEIGHT] [FONTSIZE]pt [FONTNAME]\; colid:[COLOUR_ID]\; [IS_RAW_CHAR]\; text-rise:[TEXTRISE]\; text-scale:[TEXTSCALE]\; underline:[UNDERLINE]\;'>
;
End=;

[-- END --]

[CHARSTYLE_USE MARKUP]
xStart=<span style='font:[FONTSTYLE] [WEIGHT] [FONTSIZE]pt [FONTNAME]\; colid:[COLOUR_ID]\; [IS_RAW_CHAR]\; text-rise:[TEXTRISE]\; text-scale:[TEXTSCALE]\; underline:[UNDERLINE]\;'>;
xEnd=</span>;
Start=<g id='[FID]-[STYLENUM]'>;
End=</g>;
[-- END --]

# The x=5 is a hack to allow us to uniquely identify the opening <p> when doing search & replace
# using the style definitions in the CHARSTYLE_DEFS MARKUP. 
[PARA MARKUP]
Start =[CHARSTYLE_DEFS]
<p x='5' id='[FID]'>;
End =</p>
;
Nesting Level =0;
[-- END --]

[BULLET LIST]
Start =
<ul>
;
End =
</ul>
;
Nesting Level =0;
[-- END --]

[LIST ITEM]
Start =
<p id='[FID]' listLevel='[LISTLEVEL]' >;
End =</p>;
Nesting Level =0;
[-- END --]

[CELL MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[ROW MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[TABLE MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[CLASS SPAN]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[SANS SERIF MARKUP]
Start =;
End =;
Nesting Level =0;
[-- END --]

[MONO SPACED MARKUP]
Start =;
End =;
Nesting Level =0;
[-- END --]

