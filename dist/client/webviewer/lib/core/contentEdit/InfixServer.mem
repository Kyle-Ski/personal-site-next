OWNER:InfixServer
VERSION:152

[LIMITS]
MinFontSize=10;
FontSizeGapRatio=80;
[-- END --]

[ZONE CONTROL]
Boxes =true;
Vertical Lines =true;
Horizontal Lines =true;
[-- END --]

[SPOOLER]
Input Dir =.input;
Output Dir =./output;
Error Dir =Error;
Completed Dir =Completed;
Filter =*.pdf;
Helios dt =;
Error Halt =false;
Keep Log =false;
Batch Mode =false;
Poll rate =1;
Stable time =1;
[-- END --]

[Settings]
PDF14Mode=true;
bLog File =log.txt;
Max. Log Size (kB) =68;
Log Trunc. Size (kB) =16;
Default Font Name =Open Sans;
System Font Paths =./sysfonts:/usr/share/fonts/opentype:/usr/share/fonts/truetype;
System Font Cache =/tmp/fontcache;

Do Underlining =true;
Do Bullets =true;
Do Tabs=true;
Do Runaround=true;
Do Columns=true;
Delete Text Clips=true;
Do Bidi=true;

CMaps Path =./cmaps;
Max Pages Per Block =200;
New Document Path =./fonts/New Document.pdf;
Key Functions =All;
CMYK Profile =./profiles/USWebCoatedSWOP.icc;
Hyphenation Dict =./hyphenation/hyph-en-gb.tex;
Translation Config =./transXML-XLIFF.cfg;
Convert DLL =;
Timeout=0;//120;
[-- END --]

ICENI PREFS
OWNER:INFIX
VERSION:100

[CHARSTYLE_DEFS MARKUP]
Start=
    <cstyle name="[STYLENAME]" size="[FONTSIZE]" rise="[TEXTRISE]" scale="[TEXTSCALE]"
     colour="[COLOUR]" colid="[COLOUR_ID]" fname="[FONTNAME]" fweight="[WEIGHT]" fstyle="[FONTSTYLE]" />
    ;
[-- END --]

[SEGMENTS MARKUP]
Start=<seg alpha="[HAS_ALPHA]" hash="[HASH]">;
End=</seg>;
[-- END --]

[PARA MARKUP]
Start =<p id='[FID]' pagenum='[PAGE]' bbox='[POSY] [POSX] [WIDTH] [HEIGHT]' galleyId='[GALLEY_ID]'>;
End =</p><charstyles id='[FID]'>[CHARSTYLE_DEFS]</charstyles><segments id='[FID]'>[SEGMENTS]</segments>;
Nesting Level =0;
[-- END --]

[TEXT RISE MARKUP]
Start =<span style='text-rise:[TEXTRISE]pt'>;
End =</span>;
Nesting Level =0;
[-- END --]

[HREF MARKUP]
Start =<a href="[HREF]">;
End =</a>;
Nesting Level =0;
[-- END --]

[DOC MARKUP]
Start =<?xml version="1.0" encoding="UTF-8"?>
<DOC id='[FNAME]' pagecount='[PAGECOUNT]'>
;
End =
</DOC>
;
Nesting Level =0;
[-- END --]

[FONT SIZE MARKUP]
Start =<span style='font-size:[FONTSIZE]pt'>;
End =</span>;
Nesting Level =1;
[-- END --]

[FONT MARKUP]
Start =<span style='font-family:[FONTNAME]'>;
End =</span>;
Nesting Level =0;
[-- END --]

[UNDERLINE MARKUP]
Start =<U>;
End =</U>;
Nesting Level =3;
[-- END --]

[STORY MARKUP]
Start =<STORY>
;
End =</STORY>
;
Nesting Level =0;
[-- END --]

[CELL MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[ROW MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[TABLE MARKUP]
Start = ;
End = ;
Nesting Level =0;
[-- END --]


[BULLET LIST]
Start =
<UL>
;
End =
</UL>
;
Nesting Level =0;
[-- END --]

[LIST ITEM]
Start =
<LI id='[FID]'>;
End =
</LI>
;
Nesting Level =1;
[-- END --]

[CLASS SPAN]
Start = ;
End = ;
Nesting Level =0;
[-- END --]

[COLOUR]
Start =<span style='color:#[COLOUR]'>;
End =</span>;
Nesting Level =2;
[-- END --]

[COLOUR_ID]
Start =<span style='colid:[COLOUR_ID]'>;
End =</span>;
Nesting Level =2;
[-- END --]

[SUB SCRIPT MARKUP]
Start =<SUB>;
End =</SUB>;
Nesting Level =5;
[-- END --]

[SUPER SCRIPT MARKUP]
Start =<SUP>;
End =</SUP>;
Nesting Level =6;
[-- END --]

[SANS SERIF MARKUP]
Start =;
End =;
Nesting Level =0;
[-- END --]

[SERIF MARKUP]
Start =<BR/>;
Prefix=<BR/;
Suffix=>;
End =;
Nesting Level =-1;
[-- END --]

[MONO SPACED MARKUP]
Start =;
End =;
Nesting Level =0;
[-- END --]

[ITALIC MARKUP]
Start =<em>;
End =</em>;
Nesting Level =8;
[-- END --]

[BOLD MARKUP]
Start =<strong>;
End =</strong>;
Nesting Level =7;
[-- END --]

