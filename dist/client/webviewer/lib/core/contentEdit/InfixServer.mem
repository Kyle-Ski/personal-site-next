ICENI PREFS
OWNER:INFIX
VERSION:100

# This config outputs something similar to HTML. Not used for TransPDF but for paragraph editing inside PDFTron Viewer

# Have set this to output nothing (but new-lines). Just want the style catalogue to be built in mem. Don't need the definitions output here.
[CHARSTYLE_DEFS MARKUP]
Start=
    ;
[-- END --]

# When we encounter a style change, put out all the facets we can to define it.
[CHARSTYLE_USE MARKUP]
Start=<span style='font:[FONTSTYLE] [WEIGHT] [FONTSIZE]pt [FONTNAME]\; text-decoration: [DECORATION]\;'>;
End=</span>;
[-- END --]

# Including [CHARSTYLE_DEFS] in PARA MARKUP causes the style list to be created which means you can then make use of [CHARSTYLE_USE MARKUP]
[PARA MARKUP]
Start =[CHARSTYLE_DEFS]<p id='[FID]' style='font:[FONTSTYLE] [WEIGHT] [FONTSIZE]pt [FONTNAME]\; text-decoration: [DECORATION]\;'>;
End =</p>;
Nesting Level =0;
[-- END --]

[HREF MARKUP]
Start =<a href="[HREF]">;
End =</a>;
Nesting Level =0;
[-- END --]

[GALLEY_DEFS MARKUP]
Start=
<g prev='[GALLEY_PREV]' id='[GALLEY_ID]' oid='[GALLEY_OID]' next='[GALLEY_NEXT]' bbox='[TOP] [LEFT] [BOTTOM] [RIGHT]'/>;
End=;
[-- END --]

[DOC MARKUP]
Start =<?xml version="1.0" encoding="UTF-8"?>
<DOC id='[FNAME]' pagecount='[PAGECOUNT]'>
;
End =
</DOC>
;
Nesting Level =0;
[-- END --]

[STORY MARKUP]
Start =<STORY galley_ids='[GALLEY_IDS]' galley_oids='[GALLEY_OIDS]' pagenum='[PAGE]'>
<galleys>
[GALLEY_DEFS]
</galleys>
;
End =</STORY>
;
Nesting Level =0;
[-- END --]

