% Makrooj por la finaƒµoj:
\def\adj#1{#1a. #1aj. #1ajn. #1an. #1e.}
\edef\nom#1{\adj{#1} #1o. #1oj. #1ojn. #1on.}
\def\ver#1{#1as. #1i. #1is. #1os. #1u. #1us.}
%
\patterns{
a1 e1 i1 o1 u1       % ebligu tranƒâon post la vokaloj,
2aj. 2ajn. 2an. 2as. % krom se anta≈≠ finaƒµo,
en. is. 2oj. 2ojn. 2on. 2os. 2us.
